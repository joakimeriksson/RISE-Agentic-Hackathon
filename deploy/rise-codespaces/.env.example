# Copy to .env and fill in. Never commit .env.
CODER_DOMAIN=hack.rise.se
POSTGRES_PASSWORD=change-me-long-random
# Output of: getent group docker | cut -d: -f3
DOCKER_GROUP_ID=999

# Optional OIDC login (Entra ID). Leave blank to use facilitator-created
# password accounts, which is simpler for a one-day event.
CODER_OIDC_ISSUER_URL=
CODER_OIDC_CLIENT_ID=
CODER_OIDC_CLIENT_SECRET=
CODER_OIDC_EMAIL_DOMAIN=ri.se
